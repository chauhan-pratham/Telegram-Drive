{
  "$schema": "https://schema.tauri.app/config/2",
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/chauhan-pratham/Telegram-Drive/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0RjhDMjlDQzBEM0RERTMKUldUajNkUEFuTUw0eEFPTmlRYWhRam9rWWFaQmNheGU2Sml3Yk5MbmkwQ3VIWi9XZmMvSDZCNngK"
    }
  },
  "productName": "Telegram Drive",
  "version": "2.0.0",
  "identifier": "com.chauhanpratham.telegramdrive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Telegram Drive",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:* https://asset.localhost http://asset.localhost; media-src 'self' blob: http://localhost:* http://127.0.0.1:* https://asset.localhost http://asset.localhost asset:; img-src 'self' data: blob: asset: https: http: https://asset.localhost http://asset.localhost asset:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; frame-src 'self' blob:; worker-src 'self' blob:;",
      "capabilities": [
        "default",
        "mobile-only"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
