{
  "identifier": "default",
  "description": "Standard permissions for Telegram Drive",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "os:default",
    "shell:allow-open",
    "store:default",
    "updater:default",
    "process:allow-restart",
    "deep-link:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read",
    "fs:allow-write",
    "fs:scope-app-recursive",
    "fs:scope-appcache-recursive",
    "fs:scope-cache-recursive",
    "fs:scope-temp-recursive",
    "opener:default"
  ]
}


